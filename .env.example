# Copy to .env and fill in. Nothing here is committed - .env is gitignored.
# Every value below is YOUR OWN infrastructure; the lab ships no shared credentials.

# ---- Supabase projects -------------------------------------------------------
# Project ref is the subdomain in your project URL and the suffix of the DB user
# (the pooler expects user "postgres.<ref>"). Two projects let you show the 1-click
# connect live on one while the fault has history on the other; one is enough to start.
SB_REF_PREBAKED=your_prebaked_project_ref
SB_REF_LIVE=your_live_project_ref

# Which project the app and demo.sh act on by default: prebaked | live
SB_TARGET=prebaked

# DB password. Prefer the file form: secrets/pw_prebaked and secrets/pw_live, each
# containing ONLY the password, chmod 600. SB_PW overrides the file if set.
SECRETS_DIR=./secrets
# SB_PW=

# Supabase direct DB host is IPv6-only, so use the pooler. 5432 = session mode,
# 6543 = transaction mode. Set the region to match your project.
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=5432

# ---- EC2 host running the demo app -------------------------------------------
EC2_HOST=ec2-user@your.ec2.public.ip
EC2_KEY=./secrets/ec2_key.pem

# ---- Grafana Cloud remote_write (from your stack's Prometheus/Loki details) ----
# Grafana Cloud portal -> your stack -> Prometheus / Loki -> "Send Metrics"/"Send Logs".
GCLOUD_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GCLOUD_PROM_USER=your_prom_instance_id
GCLOUD_PROM_PASS=your_grafana_cloud_access_policy_token
GCLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GCLOUD_LOKI_USER=your_loki_instance_id
GCLOUD_LOKI_PASS=your_grafana_cloud_access_policy_token

# ---- App tuning (defaults are fine) ------------------------------------------
PORT=8080
PG_POOL_MAX=12              # stays under the pooler's 15-connection session cap
STMT_TIMEOUT_MS=3000        # slow queries past this return 500, producing real 5xx
TIGHT_TIMEOUT_MS=1200
TIGHT_TIMEOUT_PATHS=/recommendations
INIT_ERROR_ROUTES=/report,/order   # seeds the 5xx counter at 0 so the panel shows a baseline
LOG_SAMPLE_N=50
LOG_SLOW_MS=1000
FIXD_PORT=8081

# ---- Load generation ---------------------------------------------------------
# RATE (req/s, open loop) is what makes recovery visible on DB CPU. CONC (closed loop)
# accelerates as latency drops and keeps CPU pegged after the fix - see app/loadgen.js.
APP_FAULT_RATE=30
APP_BASELINE_RATE=20
FAULT_PATHS=/report
BASELINE_PATHS=/order
